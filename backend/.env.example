# CynexAI Backend — Environment Variables
# This file is SERVER-SIDE ONLY. Never expose these values to the frontend.
# Copy to .env and fill in real values.

# ─── Server ───────────────────────────────────────────────
PORT=5000

# ─── Turso (LibSQL) Database ──────────────────────────────
# Get from: https://turso.tech/app
# IMPORTANT: After setting this up, regenerate your Turso auth token
# because the old token was exposed in the frontend bundle.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_new_turso_auth_token_here

# ─── JWT Authentication ────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 64
JWT_SECRET=your_super_long_random_jwt_secret_here_at_least_64_chars

# ─── Admin Authentication ──────────────────────────────────
# This moves the admin password fully server-side.
ADMIN_PASSWORD=your_strong_admin_password_here

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# ─── Razorpay (optional) ──────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
