# ───────────────────────────────────────────────────────────────────
# PRODUCTION — Set all these in your Render.com dashboard env vars
# ───────────────────────────────────────────────────────────────────

# Turso Cloud (https://turso.tech) — Get these from your Turso dashboard
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# JWT — generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_secret_here

# CORS — set to your Vercel attendance frontend URL
FRONTEND_URL=https://your-attendance-app.vercel.app

# Server Port (Render sets this automatically)
PORT=5000
