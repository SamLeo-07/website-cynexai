# CynexAI Website — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.

# ────────────────────────────────────────────
# Turso (LibSQL) Cloud Database
# Get these from: https://turso.tech/app
# ────────────────────────────────────────────
VITE_TURSO_DATABASE_URL=libsql://your-database-name.turso.io
VITE_TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ────────────────────────────────────────────
# Admin Portal
# Set a strong password. Min 12 characters.
# Example: MyStr0ng!Pass#2026
# ────────────────────────────────────────────
VITE_ADMIN_PASSWORD=your_strong_admin_password_here

# ────────────────────────────────────────────
# Google Maps API
# Get from: https://console.cloud.google.com/apis
# ────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
